    </div>

    <div class="mb-3">
        @* Html.Raw pokazuje surowy HTML, nie jest enkodowany - u¿ywaj ostro¿nie *@
        <label class="form-label">Html.Raw</label>
        <div>@Html.Raw(Model.RawHtml)</div>
        <small class="text-muted">Wstawia niebezpieczny/nieenkodowany HTML. U¿ywaj tylko z zaufanymi danymi.</small>
    </div>

    <button type="submit" class="btn btn-primary">Wyœlij</button>
