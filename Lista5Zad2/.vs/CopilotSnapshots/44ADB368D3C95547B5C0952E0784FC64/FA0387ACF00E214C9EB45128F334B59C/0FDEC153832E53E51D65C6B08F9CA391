@model Lista5Zad2.Models.StudentTasks

@{
    ViewData["Title"] = "Podsumowanie";
}

<h2>Podsumowanie</h2>

<div>
    <p>Imię: @Model.FirstName</p>
    <p>Nazwisko: @Model.LastName</p>
</div>

<table>
    <thead>
        <tr>
            <th>Zadanie</th>
            <th>Punkty</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Points.Length; i++)
        {
            <tr>
                <td>Zadanie @(@i + 1)</td>
                <td>@Model.Points[i]</td>
            </tr>
        }
    </tbody>
</table>