@model Lista5Zad2.Models.StudentTasks

@{
    ViewData["Title"] = "Podsumowanie";
}

<h2 class="mb-4">Podsumowanie</h2>

<div class="card mb-4">
    <div class="card-body">
        <p class="mb-1"><strong>Imię:</strong> @Model.FirstName</p>
        <p class="mb-1"><strong>Nazwisko:</strong> @Model.LastName</p>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Zadanie</th>
            <th>Punkty</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Points.Length; i++)
        {
            <tr>
                <td>Zadanie @(@i + 1)</td>
                <td>@Model.Points[i]</td>
            </tr>
        }
        <tr>
            <th>Razem</th>
            <th>@Model.Points.Sum()</th>
        </tr>
    </tbody>
</table>

<a asp-action="Index" class="btn btn-primary">Powrót</a>