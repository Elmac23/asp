using Neo4j.Driver;
using System;
using System.Threading.Tasks;

class Program
{
  static async Task Main(string[] args)
  {
    const string dbUri = "neo4j+s://a5b75dc8.databases.neo4j.io";
    const string dbUser = "neo4j";
    const string dbPassword = "77S3LM8Ly4CPF7lYjYu-nLx_6Ad40v0FHUiHXXnA_sY";

    await using var driver = GraphDatabase.Driver(dbUri, AuthTokens.Basic(dbUser, dbPassword));

    try
    {
      // SPOSÓB Z DOKUMENTACJI - weryfikacja połączenia
      await driver.VerifyConnectivityAsync();
      Console.WriteLine("Connection established.");

      // SPOSÓB Z DOKUMENTACJI - użycie ExecutableQuery do pobrania danych
      var result = await driver.ExecutableQuery(@"
                MATCH (p:Person) 
                RETURN p.name AS name, p.born AS born 
                ORDER BY p.name")
          .WithConfig(new QueryConfig(database: "neo4j")) // Domyślna baza w Aura to "neo4j"
          .ExecuteAsync();

      // Wyświetlenie wyników w formie tabeli
      Console.WriteLine(new string('=', 45));
      Console.WriteLine("| {0,-25} | {1,-10} |", "Name", "Born");
      Console.WriteLine(new string('-', 45));

      // SPOSÓB Z DOKUMENTACJI - iteracja po wynikach
      foreach (var record in result.Result)
      {
        var name = record.Get<string>("name");
        var born = record["born"]?.ToString() ?? "Unknown";
        Console.WriteLine("| {0,-25} | {1,-10} |", name, born);
      }

      Console.WriteLine(new string('=', 45));

      // SPOSÓB Z DOKUMENTACJI - informacje o zapytaniu
      var summary = result.Summary;
      Console.WriteLine($"The query `{summary.Query.Text}` returned {result.Result.Count} results in {summary.ResultAvailableAfter.Milliseconds} ms.");
    }
    catch (Exception ex)
    {
      Console.WriteLine($"Error: {ex.Message}");
    }

    // SPOSÓB Z DOKUMENTACJI - zamknięcie połączenia (automatyczne przez 'await using')
    Console.WriteLine("\nPress any key to exit...");
    Console.ReadKey();
  }
}