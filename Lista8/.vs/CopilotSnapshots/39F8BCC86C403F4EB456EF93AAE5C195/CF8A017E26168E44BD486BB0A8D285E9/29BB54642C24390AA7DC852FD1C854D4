@{
    Layout = null;
}

<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Home</title>
</head>
<body>
    <h1>Home - Person API demo</h1>
    <button id="getBtn">GET people</button>
    <button id="postBtn">POST new person</button>

    <pre id="output"></pre>

    <script>
        document.getElementById('getBtn').addEventListener('click', async () => {
            const res = await fetch('/api/person', { credentials: 'include' });
            const data = await res.json();
            document.getElementById('output').textContent = JSON.stringify(data, null, 2);
        });

        document.getElementById('postBtn').addEventListener('click', async () => {
            const person = { firstName: 'Test', lastName: 'User', email: 'test.user@example.com', age: 20 };
            const res = await fetch('/api/person', {
                method: 'POST',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(person)
            });
            const data = await res.json();
            document.getElementById('output').textContent = JSON.stringify(data, null, 2);
        });
    </script>
</body>
</html>
