using System.Net.Http.Json;
using lista8final.Models;

namespace lista8final.Clients
{
    public class PersonHttpClientExample
    {
        private readonly HttpClient _http;
        public PersonHttpClientExample(HttpClient http)
        {
            _http = http;
        }

        public async Task<List<Person>?> GetAllAsync()
        {
            return await _http.GetFromJsonAsync<List<Person>>("api/persons");
        }

        public async Task<Person?> CreateAsync(Person person)
        {
            var res = await _http.PostAsJsonAsync("api/persons", person);
            if (res.IsSuccessStatusCode)
            {
                return await res.Content.ReadFromJsonAsync<Person>();
            }
            return null;
        }
    }
}
