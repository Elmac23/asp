@{
    Layout = null;
}
<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Login</title>
</head>
<body>
  <h1>Login</h1>
  <form id="loginForm" method="post" asp-controller="Account" asp-action="Login">
    <label>Username: <input name="username" /></label><br />
    <label>Password: <input name="password" type="password" /></label><br />
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
    <button type="submit">Login (cookie)</button>
    <button type="button" id="btnJwt">Login (JWT)</button>
  </form>
  <div id="msg" style="color:red"></div>

  <script>
    // When user clicks JWT login button, send credentials to api/auth/token, store token and redirect
    document.getElementById('btnJwt').addEventListener('click', async () => {
      const username = document.querySelector('input[name="username"]').value;
      const password = document.querySelector('input[name="password"]').value;
      const msg = document.getElementById('msg');
      msg.textContent = '';
      if (!username || !password) { msg.textContent = 'Enter username and password'; return; }

      try {
        const res = await fetch('/api/auth/token', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });
        if (!res.ok) {
          msg.textContent = 'Login failed: ' + res.status;
          return;
        }
        const data = await res.json();
        if (data && data.token) {
          // store token for later use (localStorage used for demo)
          localStorage.setItem('jwt', data.token);
          // redirect to home page
          window.location = '/Home/Index';
        } else {
          msg.textContent = 'No token returned';
        }
      } catch (e) {
        msg.textContent = 'Error: ' + e;
      }
    });
  </script>
</body>
</html>