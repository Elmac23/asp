@{
    Layout = null;
}
<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Home</title>
</head>
<body>
  <h1>Home - protected</h1>
  <button id="btnApi">Call Persons API</button>
  <pre id="out"></pre>

  <script src="/js/personsClient.js"></script>
  <script>
    document.getElementById('btnApi').addEventListener('click', async () => {
      // fetch with credentials to include cookie
      const res = await fetch('/api/persons', { credentials: 'same-origin' });
      const out = document.getElementById('out');
      if (!res.ok) { out.textContent = 'Error: ' + res.status; return; }
      const data = await res.json();
      out.textContent = JSON.stringify(data, null, 2);
    });
  </script>
</body>
</html>