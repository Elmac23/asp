<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Alt Layout - @ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <div class="container">
        <header><h1>Alternate Layout</h1></header>
        @RenderBody()

        @* Render optional 'Extra' section if a view defines it *@
        @RenderSection("Extra", required: false)
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
