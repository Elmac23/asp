@{
    Layout = ViewData["Layout"] as string ?? "_Layout";
}
<h2>CMS Page</h2>
<p>Requested path: @ViewData["CmsPath"]</p>

@{ 
    if (IsSectionDefined("Extra")) {
        <div class="alert alert-info">Extra section provided.</div>
    }
}

@section Extra {
    <p>This is an extra optional section from the CMS view.</p>
}

@await Html.PartialAsync("_CmsPartial")
